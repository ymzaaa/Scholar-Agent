# LLM is optional. A configured key never authorizes a call by itself.
# Every generation remains offline unless the caller explicitly authorizes a task.
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_MODEL=deepseek-v4-pro
LLM_BASE_URL=https://api.deepseek.com
LLM_TEMPERATURE=0
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=120
LLM_MAX_RETRIES=2

# Pipeline settings
CONFIDENCE_THRESHOLD=0.85
MAX_COMPILE_ROUNDS=3
LATEX_COMPILER=xelatex

# Backend integration
# The default repository layout is detected automatically. Only uncomment these
# when the backend and stage1 directories are deployed separately.
# STAGE1_DIR=../stage1
# SCHOLAR_WORKSPACE_ROOT=../runtime/project-workspace
