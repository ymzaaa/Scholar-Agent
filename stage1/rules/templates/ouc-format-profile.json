  "extra_rules": [
    {
      "rule_id": "OUC-PDF-A4",
      "category": "PDF页面",
      "item": "输出PDF页面尺寸必须为A4",
      "phase": "pdf",
      "disposition": "block",
      "detector": "pdf_page_size",
      "source": "OUC模板页面画像",
      "config": {"size_points": [595.276, 841.89], "tolerance_points": 2.0},
      "layer": "template"
    },
    {
      "rule_id": "OUC-TEMPLATE-PLACEHOLDER",
      "category": "模板完整性",
      "item": "OUC模板的受控中文占位文本必须被替换",
      "phase": "source",
      "disposition": "block",
      "detector": "forbid_regex",
      "source": "OUC模板适配器契约",
      "config": {"pattern": "待生成论文标题|待生成论文封面", "paths": ["main.tex", "data/cover.tex"]},
      "layer": "template"
    },
    {
      "rule_id": "OUC-FIGURE-ENGLISH-CAPTION",
      "category": "图题完整性",
      "item": "模板要求的英文图题必须存在且不得复制中文",
      "phase": "source",
      "disposition": "degrade",
      "detector": "bilingual_caption",
      "source": "研究生论文书写规范.docx与OUC模板题注契约",
      "config": {"kind": "figure", "paths": ["contents/*.tex"]},
      "layer": "template"
    },
    {
      "rule_id": "OUC-TABLE-ENGLISH-CAPTION",
      "category": "表题完整性",
      "item": "模板要求的英文表题必须存在且不得复制中文",
      "phase": "source",
      "disposition": "degrade",
      "detector": "bilingual_caption",
      "source": "研究生论文书写规范.docx与OUC模板题注契约",
      "config": {"kind": "table", "paths": ["contents/*.tex"]},
      "layer": "template"
    },
    {
      "rule_id": "OUC-TOC-ENGLISH-HEADINGS",
      "category": "英文目录完整性",
      "item": "英文目录中的章、节、小节标题必须为有效英文",
      "phase": "source",
      "disposition": "degrade",
      "detector": "english_headings",
      "source": "研究生论文书写规范.docx与OUC模板目录契约",
      "config": {
        "commands": ["enchapter", "ensection", "ensubsection"],
        "paths": ["contents/*.tex"]
      },
      "layer": "template"
    }
  ],
  "rules": []
